# Claude AI 辅助文件
.claude/

# 任务认领锁运行时文件（目录结构已通过 .gitkeep 提交）
company/task_claims/*/.claim/

# Agent 发件箱（可能包含敏感信息如 API key）
company/chairman_outbox/

# 微信锁文件
company/.wechat_locks/
company/wechat_locks/

# 凭证文件（绝对不能提交）
WECOM_CALLBACK_CREDS.md

# GitHub 自动同步脚本的日志
auto_sync_log.txt

# ==================== 🔴 隐私保护 — 绝不提交 ====================

# 日志文件（可能包含 URL 参数中的密码）
*.log

# 数据库文件（可能包含个人数据）
*.db
*.sqlite
*.sqlite3

# 董事长收件箱（微信聊天记录、个人指令）
company/chairman_inbox/processed/

# 执行上下文和运行时状态（持仓明细、资金量、交易记录、监控状态）
company/departments/execution/context_state.json
company/departments/execution/monitor_state.json
company/departments/execution/*.json
company/departments/execution/*.txt
company/departments/execution/*.bin
company/departments/execution/*.jsonl

# 微信推送记录（联系人信息）
company/wechat_pushed.json

# 研究报告（个人分析结论）
company/reports/

# 定时任务配置
company/cron_config.json

# 微信凭证说明文件
WECOM_CALLBACK_CREDS.md

# 市场监控数据快照（可能含个人持仓分析）
company/market_snapshots/
scripts/market_data/

# 临时构建脚本
_build_resume.py
_build_resume_en.py

# ==================== 🔴 运行时数据 — 绝不提交 ====================

# 服务器日志（含 auth token）
company/.server_log.txt

# 运行时状态文件
company/.watcher_state.json
company/watcher_seen.json

# 董事长持仓数据（个人财务信息）
company/chairman_position_tracker.json

# 舆情数据采集结果
company/sentiment_data/collector/*.json
!company/sentiment_data/collector/.gitkeep

# 量化原始数据（过大的 parquet 文件）
quant_framework/data/raw/**/*.parquet

# HVAC 项目数据文件（可能含商业信息）
projects/hvac_manuals/checkpoint.json
projects/hvac_manuals/pdf_search_results.xlsx
projects/hvac_manuals/manifest_backup_before_jci_update.json
projects/hvac_manuals/_colleague_handoff/
projects/hvac_manuals/_handoff_ref/

# HVAC 下载的 PDF 手册（可从公开源重新下载）
projects/hvac_manuals/pdf_downloads/

# ==================== 🔴 董事长个人成长数据 — 绝不提交 ====================
# 包含薪资、技能缺口、跳槽计划、面试准备等敏感个人信息
