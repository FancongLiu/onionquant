  <script>
    
    // Specify the URL of the page where you want to set noindex
    const noIndexPageUrl = 'https://discover.rheem.com/commercial-air/billy-gails';

    // Check if the current page is the specified one
    if (window.location.href === noIndexPageUrl) {
        // Look for an existing meta robots tag
        let metaRobots = document.querySelector('meta[name="robots"]');

        if (metaRobots) {
            // Update content of the existing meta robots tag
            metaRobots.setAttribute('content', 'noindex');
        } else {
            // Create a new meta robots tag and append it to the head
            metaRobots = document.createElement('meta');
            metaRobots.setAttribute('name', 'robots');
            metaRobots.setAttribute('content', 'noindex');
            document.head.appendChild(metaRobots);
        }

        console.log('Meta robots set to noindex on this page.');
    };

</script>
