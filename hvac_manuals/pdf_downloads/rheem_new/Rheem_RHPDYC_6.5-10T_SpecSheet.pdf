    .case-studies-hero{height:17.5rem;display:flex;align-items:center;background-color:#191919}.case-studies-hero h1{font-family:RheemSansBold,sans-serif;font-size:2.5rem !important;line-height:2.75rem;color:#fff}.case-studies-hero__container{max-width:32rem;text-align:center;padding:0 .75rem;margin:0 auto}.case-studies-intro{background-color:#f5f5f6;padding:83px 12px 60px 12px;text-align:center}.case-studies-intro__container{max-width:28rem;margin:0 auto}.case-studies-intro h2{font-family:RheemSansLight,sans-serif;font-size:32px !important;line-height:34px;padding-bottom:20px;color:#4a4a4a}.case-studies-intro p{font-size:14px;line-height:21px;color:#63666a}.case-studies{background-color:#f5f5f6}.case-studies__grid{max-width:64rem;margin:0 auto;padding:0 .75rem 3rem .75rem;display:grid;row-gap:1rem}@media(min-width: 600px){.case-studies__grid{grid-template-columns:repeat(2, 1fr);column-gap:1rem}}@media(min-width: 768px){.case-studies__grid{grid-template-columns:repeat(3, 1fr)}}.case-studies__grid .thumbnail{font-family:RheemSansRoman,sans-serif}.case-studies__grid .thumbnail h3{color:#63666a;font-family:RheemSansBold,sans-serif;font-size:20px;line-height:24px;padding-bottom:16px}.case-studies__grid .thumbnail h4{color:#4a4a4a;font-size:10px;line-height:21px;text-transform:uppercase;padding-bottom:15px}.case-studies__grid .thumbnail a{font-size:14px;line-height:16px;display:flex;align-items:center}.case-studies__grid .thumbnail a p{color:#e4002b;padding-right:.25rem}.case-studies__grid .thumbnail a span{padding-bottom:.1rem;transition:.2s ease}.case-studies__grid .thumbnail a:hover span{transform:translateX(0.24rem)}.case-studies__grid .thumbnail a:hover p{font-weight:bold}.case-studies__grid .thumbnail .text{padding:21px 30px 19px 30px;background-color:#fff;border-bottom-right-radius:.5rem;border-bottom-left-radius:.5rem}/*# sourceMappingURL=rheem.css.map */

