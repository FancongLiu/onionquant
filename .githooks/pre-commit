#!/bin/bash
# Pre-commit hook: scan for potential secrets before allowing commit

RED='\033[0;31m'
NC='\033[0m'

# Patterns to detect
PATTERNS=(
    'sk-[a-zA-Z0-9]{20,}'                    # OpenAI/DeepSeek API key
    'AKIA[0-9A-Z]{16}'                        # AWS Access Key
    'ghp_[a-zA-Z0-9]{36}'                     # GitHub Personal Access Token
    'xox[baprs]-[a-zA-Z0-9-]+'               # Slack Token
    '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'  # UUID (possible token)
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
FOUND=0

for file in $STAGED_FILES; do
    # Skip binary and generated files
    case "$file" in
        *.png|*.jpg|*.jpeg|*.gif|*.ico|*.pdf|*.zip|*.tar|*.gz|*.whl|*.egg|*.pyc) continue ;;
        package-lock.json|*.min.js|*.min.css) continue ;;
    esac

    if [ ! -f "$file" ]; then continue; fi

    for pattern in "${PATTERNS[@]}"; do
        if grep -E -q "$pattern" "$file" 2>/dev/null; then
            echo -e "${RED}[SECURITY] Possible secret detected in: $file${NC}"
            echo "  Pattern matched: $pattern"
            echo "  Please remove the secret or use an environment variable."
            FOUND=1
        fi
    done

    # Check for common password variable names with hardcoded values
    if grep -E -q "(password|passwd|secret|api_key|apikey)\s*=\s*['\"][^'\"]{8,}['\"]" "$file" 2>/dev/null; then
        echo -e "${RED}[SECURITY] Hardcoded credential detected in: $file${NC}"
        echo "  Use os.getenv() or os.environ[] instead."
        FOUND=1
    fi
done

if [ $FOUND -eq 1 ]; then
    echo ""
    echo -e "${RED}Commit blocked: secrets detected.${NC}"
    echo "If this is a false positive, run: git commit --no-verify"
    exit 1
fi

echo "[SECURITY] Pre-commit scan passed."
exit 0
