# ============================================================
# OnionQuant — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored and will NEVER be committed.
# ============================================================

# ── LLM API Keys ──
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Primary OpenAI-compatible provider for OnionQuant AI calls.
ONIONQUANT_LLM_PROVIDER=ergouzi
ONIONQUANT_LLM_BASE_URL=https://ergouzi.life/v1
ONIONQUANT_LLM_MODEL=gpt-5.5
ONIONQUANT_LLM_WIRE_API=responses
ONIONQUANT_LLM_API_KEY=your_ergouzi_api_key_here

# SiliconFlow (GLM models): https://siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
GLM_MODEL_NAME=glm-4

# ── WeChat Work (Enterprise WeChat Bot) ──
# Register: https://work.weixin.qq.com
# Path: WeChat Work Admin → App Management → Self-built App
WECHAT_CORP_ID=your_corp_id_here
WECHAT_AGENT_ID=your_agent_id_here
WECHAT_SECRET=your_app_secret_here
WECHAT_CALLBACK_TOKEN=your_callback_token_here
WECHAT_CALLBACK_AES_KEY=your_callback_aes_key_here
WECHAT_MAX_PUSH_PER_RUN=1
WECHAT_WATCHER_MIN_INTERVAL_SECONDS=3600

# ── Dashboard Auth (HTTP Basic Auth) ──
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose_a_strong_password

# ── Alpaca Paper Trading ──
# Register: https://alpaca.markets → Paper Trading Dashboard
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# ── Neo4j Knowledge Graph ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── PostgreSQL / TimescaleDB ──
POSTGRES_USER=onionquant
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=onionquant

# ── Cloudflare Tunnel (optional) ──
# Used to expose the local dashboard to the internet
# https://one.dash.cloudflare.com → Access → Tunnels
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
